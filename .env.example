# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=fsourceinsight
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=fsourceinsight
DATABASE_URL=mysql+pymysql://fsourceinsight:change-me@mysql:3306/fsourceinsight?charset=utf8mb4

# MySQL container
MYSQL_ROOT_PASSWORD=change-me-root

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# LLM API Keys (referenced by llm_config.api_key_env_var)
# Mixed strategy: DeepSeek for bulk tasks, OpenAI for structured output
DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Email (SMTP)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=digest@fsourceinsight.com

# Crawl defaults
DEFAULT_CRAWL_FREQUENCY_MINUTES=60

# LLM cost control (USD per day, 0 = unlimited)
LLM_DAILY_BUDGET_USD=5.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Sentry (optional)
# SENTRY_DSN=https://xxx@sentry.io/123
# SENTRY_TRACES_RATE=0.1
